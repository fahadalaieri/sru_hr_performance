# Copy this file to .env.local and fill in real values from the Supabase
# dashboard (Project Settings → API). .env.local itself is gitignored —
# never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- University single sign-on (SRU SSO, dt.sr.edu.sa/sso/v1) — optional ---
# Both are issued by the Digital Transformation Department when this platform
# is registered there. Leave them unset to hide the SSO button entirely.
# Public: the platform's app key as registered in the SSO console.
NEXT_PUBLIC_SRU_SSO_APP_KEY=
# Public, optional: the name shown on the SSO gate (defaults to برنامج إدارة الأداء).
NEXT_PUBLIC_SRU_SSO_APP_NAME=
# Server-only: JSON map of kid -> assertion secret, copied from the identity
# project's vault entries assertion_secret_<app_key>_v<N>. Keep the previous
# version during rotation, e.g. {"v1":"...","v2":"..."}.
SRU_SSO_ASSERTION_SECRETS=

# Daily evaluation reminders (phase 2 item 7): shared secret checked by
# POST /api/evaluations/reminders; the Netlify scheduled function sends it.
# Leave empty to disable the route (503).
EVALUATION_REMINDER_SECRET=
